{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prosight.local/schemas/organization-ingestion-profile.schema.json",
  "title": "Organization ingestion mapping profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "name", "sheets"],
  "properties": {
    "catalog_version": {"type": "integer", "minimum": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 250},
    "description": {"type": ["string", "null"], "maxLength": 2000},
    "sheets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_type", "sheet_name", "columns"],
        "properties": {
          "entity_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "sheet_name": {"type": "string", "minLength": 1, "maxLength": 250},
          "sheet_aliases": {
            "type": "array", "maxItems": 50,
            "items": {"type": "string", "minLength": 1, "maxLength": 250}
          },
          "columns": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "oneOf": [
                {"type": "string", "minLength": 1, "maxLength": 250},
                {"type": "array", "minItems": 1, "maxItems": 50,
                 "items": {"type": "string", "minLength": 1, "maxLength": 250}}
              ]
            }
          }
        }
      }
    }
  }
}
