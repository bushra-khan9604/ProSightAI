# Copy this file to .env and enter secrets only in your local copy.
PROSIGHT_AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_ORCHESTRATOR_REASONING=none
OPENAI_WRITER_REASONING=low
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
PROSIGHT_LOG_LEVEL=INFO

# Supabase production data, Auth, Storage, and pgvector.
PROSIGHT_DATA_BACKEND=supabase
SUPABASE_PROJECT_REF=
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
PROSIGHT_BOOTSTRAP_ADMIN_EMAIL=
PROSIGHT_APP_URL=http://127.0.0.1:8000
EMBEDDING_WORKER_SECRET=

# Vite receives only the public project settings.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
