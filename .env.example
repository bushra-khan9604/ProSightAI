# Copy this file to .env and enter secrets only in your local copy.
PROSIGHT_AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_ORCHESTRATOR_REASONING=none
OPENAI_WRITER_REASONING=low
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
PROSIGHT_LOG_LEVEL=INFO
PROSIGHT_AUTH_COOKIE=prosight_session
PROSIGHT_AUTH_COOKIE_SECURE=false
PROSIGHT_SESSION_TTL_SECONDS=28800
PROSIGHT_AUTH_PROVIDER=supabase
SUPABASE_URL=https://rhtcwtmkgeuvvyuirpup.supabase.co
SUPABASE_PUBLISHABLE_KEY=
PROSIGHT_AUTH_REQUIRED=true
PROSIGHT_SEED_DEMO_USERS=false

# PostgreSQL + pgvector (server only). Copy the URI from Supabase > Connect.
# A configured URL selects PostgreSQL automatically unless explicitly overridden.
PROSIGHT_DATABASE_URL=
# PROSIGHT_DATABASE_BACKEND=postgres
# Never prefix database credentials with VITE_ or put them in browser code.

# Optional server-managed JSON mapping profile for Excel project creation.
# Defaults to the bundled schemas/project-mapping.json.
# PROSIGHT_PROJECT_MAPPING_PATH=C:/path/to/organization-project-mapping.json
